rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCustomer(uid) {
      return isAuthenticated() && (
        request.auth.uid == uid ||
        (resource != null && 'linkedUids' in resource.data && request.auth.uid in resource.data.linkedUids) ||
        (resource != null && 'phone' in resource.data &&
         exists(/databases/$(database)/documents/phone_index/$(resource.data.phone)) &&
         get(/databases/$(database)/documents/phone_index/$(resource.data.phone)).data.customerId == uid) ||
        (exists(/databases/$(database)/documents/customers/$(uid)) &&
         'linkedUids' in get(/databases/$(database)/documents/customers/$(uid)).data &&
         request.auth.uid in get(/databases/$(database)/documents/customers/$(uid)).data.linkedUids) ||
        (exists(/databases/$(database)/documents/customers/$(uid)) &&
         'phone' in get(/databases/$(database)/documents/customers/$(uid)).data &&
         exists(/databases/$(database)/documents/phone_index/$(get(/databases/$(database)/documents/customers/$(uid)).data.phone)) &&
         get(/databases/$(database)/documents/phone_index/$(get(/databases/$(database)/documents/customers/$(uid)).data.phone)).data.customerId == uid)
      );
    }

    function getStaffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isStaffMember() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isActiveStaff() {
      return isStaffMember() && getStaffData().active == true;
    }

    function isAdmin() {
      return isActiveStaff() && getStaffData().role == 'admin';
    }

    // ----------------------------------------------------
    // PHONE INDEX COLLECTION (Multi-device customer continuity)
    // ----------------------------------------------------
    match /phone_index/{phone} {
      // Authenticated users can retrieve customerId by phone
      allow get: if isAuthenticated() && phone.matches('^[6-9][0-9]{9}$');

      // Create or update phone index mapping during customer registration
      allow create, update: if isAuthenticated()
        && phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.customerId is string;

      // Allow admin to delete phone index
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // CUSTOMERS COLLECTION
    // ----------------------------------------------------
    match /customers/{uid} {
      // Customers can read their own profile; Active staff/admin can read customer profiles
      allow read: if isCustomer(uid) || isActiveStaff();

      // Only the authenticated customer can create their own initial profile
      allow create: if isCustomer(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.stampCount == 0
        && request.resource.data.cycleNumber == 1
        && request.resource.data.totalVisits == 0
        && request.resource.data.totalRewards == 0
        && request.resource.data.rewardAvailable == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!('lastVisitAt' in request.resource.data) || request.resource.data.lastVisitAt == null);

      // Updates:
      // 1. Customer updating their own profile (name, phone, or multi-device linking) - cannot touch stamps/rewards/cycles
      // 2. Active Staff during approval transaction or reward redemption
      allow update: if (
        // Customer profile self-update or multi-device linking
        isCustomer(uid)
        && request.resource.data.stampCount == resource.data.stampCount
        && request.resource.data.cycleNumber == resource.data.cycleNumber
        && request.resource.data.totalVisits == resource.data.totalVisits
        && request.resource.data.totalRewards == resource.data.totalRewards
        && request.resource.data.rewardAvailable == resource.data.rewardAvailable
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
      ) || (
        // Active Staff performing transaction (visit approval or reward redemption)
        isActiveStaff()
        && request.resource.data.name == resource.data.name
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.stampCount is int
        && request.resource.data.stampCount >= 0
        && request.resource.data.stampCount <= 20
        && request.resource.data.cycleNumber is int
        && request.resource.data.cycleNumber >= resource.data.cycleNumber
        && request.resource.data.totalVisits is int
        && request.resource.data.totalVisits >= resource.data.totalVisits
        && request.resource.data.totalRewards is int
        && request.resource.data.totalRewards >= resource.data.totalRewards
        && request.resource.data.rewardAvailable is bool
      ) || (
        // Super-Admin management (stamp reset, cycle adjustment, profile fix)
        isAdmin()
      );

      // Only Admin can delete customer records
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // VISITS COLLECTION
    // ----------------------------------------------------
    match /visits/{visitId} {
      // Customers can read their own visits; Active staff/admin can read all visits
      allow get: if (isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isCustomer(resource.data.customerId)
      )) || isActiveStaff();

      allow list: if (isAuthenticated() && request.query.limit <= 25) || isActiveStaff();

      // Customer creates their own pending visit
      allow create: if isAuthenticated()
        && (
          request.resource.data.customerId == request.auth.uid ||
          isCustomer(request.resource.data.customerId)
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.stampNumber == 0
        && request.resource.data.cycleNumber is int
        && request.resource.data.cycleNumber >= 1
        && request.resource.data.createdAt == request.time
        && (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == null)
        && (!('approvedBy' in request.resource.data) || request.resource.data.approvedBy == null);

      // Active staff approves or rejects pending visit
      allow update: if (isActiveStaff()
        && resource.data.status == 'pending'
        && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected')
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.cycleNumber == resource.data.cycleNumber
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.approvedAt == request.time
        && request.resource.data.approvedBy == request.auth.uid
        && (
          (request.resource.data.status == 'approved' && request.resource.data.stampNumber >= 1 && request.resource.data.stampNumber <= 20)
          || (request.resource.data.status == 'rejected' && request.resource.data.stampNumber == 0)
        )
      ) || isAdmin();

      // Only Admin can delete visit records
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // REWARDS COLLECTION
    // ----------------------------------------------------
    match /rewards/{rewardId} {
      // Customers can read their own rewards; Active staff/admin can read all rewards
      allow get: if (isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isCustomer(resource.data.customerId)
      )) || isActiveStaff();

      allow list: if (isAuthenticated() && request.query.limit <= 25) || isActiveStaff();

      // Rewards are created ONLY by active staff as part of target stamp visit approval transaction
      allow create: if isActiveStaff()
        && request.resource.data.status == 'available'
        && request.resource.data.type is string
        && request.resource.data.value is int
        && request.resource.data.value > 0
        && request.resource.data.cycleNumber is int
        && request.resource.data.cycleNumber >= 1
        && request.resource.data.customerId is string
        && request.resource.data.createdAt == request.time
        && (!('redeemedAt' in request.resource.data) || request.resource.data.redeemedAt == null)
        && (!('redeemedBy' in request.resource.data) || request.resource.data.redeemedBy == null);

      // Active staff redeems reward; Admin can manage
      allow update: if (isActiveStaff()
        && resource.data.status == 'available'
        && request.resource.data.status == 'redeemed'
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.cycleNumber == resource.data.cycleNumber
        && request.resource.data.type == resource.data.type
        && request.resource.data.value == resource.data.value
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.redeemedAt == request.time
        && request.resource.data.redeemedBy == request.auth.uid
      ) || isAdmin();

      // Only Admin can delete reward records
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // SETTINGS COLLECTION (Universal Multi-Business SaaS Configuration)
    // ----------------------------------------------------
    match /settings/{docId} {
      // Authenticated users can read public configuration
      allow read: if isAuthenticated();

      // Only Super-Admin can update business settings
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // STAFF COLLECTION
    // ----------------------------------------------------
    match /staff/{uid} {
      // Staff member can read their own profile; Active staff/admin can list staff
      allow read: if (isAuthenticated() && request.auth.uid == uid) || isActiveStaff();

      // Only Admin can create, update, or delete staff records
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // DEFAULT DENY FOR EVERYTHING ELSE
    // ----------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
